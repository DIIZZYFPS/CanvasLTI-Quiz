# Copy to .env and fill in. See the README ("Configuration") for what each setting does.

# --- Flask ------------------------------------------------------------------------------
# REQUIRED in production. Signs the session cookie and encrypts the Canvas token stored in it.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at startup, which breaks logins across restarts/workers.
SECRET_KEY=change-me-to-a-long-random-string
# Where LTI launch state is cached (default /tmp/flask_cache)
# CACHE_DIR=/var/cache/canvaslti-quiz
# Largest accepted upload / pasted quiz, in MB (default 10)
# MAX_UPLOAD_MB=10
# Development only: enable Flask's debugger with `FLASK_DEBUG=1 python main.py`. Never on a server.
# FLASK_DEBUG=1

# --- Canvas (only needed to upload straight into a course) -------------------------------
CANVAS_DOMAIN=https://your-canvas-instance.instructure.com
# The Canvas REST API developer key used for uploads (separate from the LTI key)
CANVAS_API_CLIENT_ID=your_canvas_oauth_client_id
CANVAS_API_CLIENT_SECRET=your_canvas_oauth_client_secret
CANVAS_OAUTH_REDIRECT_URI=https://your-app-domain.com/api/auth/callback

# --- LTI 1.3 -----------------------------------------------------------------------------
# Optional. PEM text of the tool's private key; only used when app/config/private.key is absent.
# LTI_PRIVATE_KEY=

# --- Hardening ---------------------------------------------------------------------------
# Optional. Only these hosts may embed the tool in an iframe (space-separated). Off by default:
# the right hosts depend on your Canvas setup (a vanity domain differs from CANVAS_DOMAIN).
# FRAME_ANCESTORS=https://your-canvas-instance.instructure.com
