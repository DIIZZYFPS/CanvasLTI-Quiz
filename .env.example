# Canvas API Configuration
CANVAS_DOMAIN=https://your-canvas-instance.instructure.com
CANVAS_OAUTH_REDIRECT_URI=https://your-app-domain.com/api/auth/callback

# LTI 1.3 Keys (Optional but recommended for prod)
LTI_PRIVATE_KEY= key
CANVAS_API_CLIENT_ID=your_canvas_oauth_client_id
CANVAS_API_CLIENT_SECRET=key

# Flask Configuration
# REQUIRED in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Signs the session cookie and encrypts the Canvas token stored in it. If unset, a random
# key is generated at startup, which breaks logins across restarts and workers.
SECRET_KEY=your_secure_random_flask_secret
# Optional: largest accepted upload / pasted quiz, in MB (default 10)
# MAX_UPLOAD_MB=10
